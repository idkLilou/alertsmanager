{
    "name": "idklilou/alertsmanager",
    "description": "GLPI plugin to manage alerts",
    "type": "glpi-plugin",
    "license": "GPL-2.0-or-later",

    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "glpi-project/tools": "^0.8.3",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2.99"
        },
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Glpi\\Tools\\": "../../tools/src/"
        }
    }
}
